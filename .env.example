# ---- Supabase (shared project with tw-water-automation — use a scoped service role key) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- WhatsApp bot ----
# Folder where Baileys persists the multi-file auth session (gitignored). Point this at a
# durable path on the host — losing it means re-scanning the QR code.
BOT_AUTH_STATE_DIR=./auth_state

# JID of the committee approval group (e.g. "1203630XXXXXX@g.us"). Leave blank until
# Phase 0 "confirm committee approval group" is resolved — the bot logs discovered
# group JIDs on startup to help you find this value.
COMMITTEE_GROUP_JID=

# JID of the resident-facing announcements channel/group once created. WhatsApp
# Channels (as opposed to groups) end in "@newsletter" — Baileys 6.7.24 sends to
# these natively via the normal sendMessage() path, no third-party bridge needed.
ANNOUNCEMENTS_JID=

# ---- Anti-ban tuning (baileys-antiban) — see infra notes in README before changing ----
ANTIBAN_MAX_PER_MINUTE=15
ANTIBAN_MAX_PER_HOUR=400
ANTIBAN_MAX_PER_DAY=2000
# Where warm-up-ramp/rate-limiter state persists across restarts and reconnects.
# Gitignored, regenerable — delete it to reset the number back to warm-up day 1.
ANTIBAN_STATE_FILE=./antiban-state.json

# ---- Health heartbeat ----
HEALTH_HEARTBEAT_INTERVAL_MS=300000
